# Root containing datasets, evaluation reports, diagnostics, and backups.
SWE_MASTER_ARTIFACT_ROOT=/path/to/SWE-Master-artifacts

# Root containing machine-local virtual environments and other runtime state.
SWE_MASTER_RUNTIME_ROOT=/path/to/SWE-Master-runtime

# Model locations are machine-local and must never be committed with real credentials.
QWEN3_BASE_MODEL=/path/to/Qwen3-4B-Instruct-2507
QWEN3_FULL_SFT_MODEL=/path/to/reasoning-content-full-sft-checkpoint
